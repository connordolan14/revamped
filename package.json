{
  "name": "revamped-league",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "lint": "eslint eslint.config.js scripts web/app.js && tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "build": "node scripts/buildProduction.mjs",
    "smoke": "node scripts/smoke.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run validate && npm run build && npm run smoke",
    "validate": "tsx scripts/validate2025.ts",
    "build:bundle": "tsx scripts/buildBundle.ts",
    "build:live": "tsx src/pipeline/buildLive.ts",
    "writeup": "tsx src/pipeline/writeup.ts",
    "render:email": "node scripts/renderEmailImages.mjs",
    "email": "tsx src/pipeline/email.ts",
    "standalone": "node scripts/buildStandalone.mjs",
    "shots": "node scripts/shoot.mjs",
    "typecheck": "tsc --noEmit",
    "weekly": "npm run build:live && npm run render:email && npm run email",
    "test": "vitest run",
    "test:watch": "vitest",
    "recap:context": "tsx src/pipeline/generateRecap.ts context",
    "recap:persist": "tsx src/pipeline/generateRecap.ts persist",
    "recap:research": "tsx src/pipeline/generateRecap.ts research",
    "recap:status": "tsx src/pipeline/generateRecap.ts status"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "playwright": "^1.62.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "marked": "^18.0.10"
  }
}
